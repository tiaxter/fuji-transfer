<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/md_background</item>
        <item name="android:statusBarColor">@color/md_background</item>
        <item name="android:navigationBarColor">@color/md_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/md_primary</item>
        <item name="android:colorPrimary">@color/md_primary</item>
        <item name="android:textColorPrimary">@color/md_on_surface</item>
        <item name="android:textColorSecondary">@color/md_on_surface_variant</item>
    </style>

    <!-- Full-screen photo preview (black, like the design's "Anteprima") -->
    <!-- details over the full-size viewer: a real sheet, dimmed background, slides up from the bottom -->
    <style name="DetailsSheet" parent="android:Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.InputMethod</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
    </style>

    <style name="PreviewDialog" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">@color/md_surface_low</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- The full-size viewer: like PreviewDialog, but the window is see-through, so that while a vertical drag closes
         the viewer its black fades and the gallery shows behind (the viewer's own layout is black). -->
    <style name="ViewerDialog" parent="PreviewDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Type scale (Material 3) -->
    <style name="Text">
        <item name="android:textColor">@color/md_on_surface</item>
    </style>
    <style name="Text.TitleLarge">
        <item name="android:textSize">22sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="Text.Headline">
        <item name="android:textSize">24sp</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <style name="Text.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="Text.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="Text.Label">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/md_on_surface_variant</item>
    </style>
    <style name="Text.SectionTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/md_primary</item>
    </style>

    <!-- Buttons -->
    <style name="Button">
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Button.Filled">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/on_button</item>
        <item name="android:drawableTint">@color/on_button</item>
    </style>
    <style name="Button.FilledSmall">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/on_button</item>
        <item name="android:drawableTint">@color/on_button</item>
        <item name="android:paddingStart">16dp</item>
    </style>
    <style name="Button.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/on_button_tonal</item>
        <item name="android:drawableTint">@color/on_button_tonal</item>
    </style>
    <style name="Button.Outlined">
        <item name="android:background">@drawable/bg_button_outlined</item>
        <item name="android:textColor">@color/text_button</item>
    </style>
    <style name="Button.Text">
        <item name="android:background">@drawable/bg_button_text</item>
        <item name="android:textColor">@color/text_button</item>
        <item name="android:drawableTint">@color/text_button</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <style name="IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/md_on_surface_variant</item>
    </style>

    <!-- Filter chip (M3) -->
    <style name="ChipText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:drawableTint">@color/on_chip</item>
        <item name="android:textColor">@color/on_chip</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- "Come funziona" / steps -->
    <style name="StepIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_circle_secondary_container</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/md_on_secondary_container</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
