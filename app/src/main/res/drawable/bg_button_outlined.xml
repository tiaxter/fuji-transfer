<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined button. Pressed: corners tighten. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F000000">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="220">
            <item android:state_pressed="true">
                <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="@color/md_outline" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="1dp" android:color="@color/md_outline" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
