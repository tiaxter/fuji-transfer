<?xml version="1.0" encoding="utf-8"?>
<!-- Connected pair, first button (tonal). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#1F000000">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="8dp" android:bottomRightRadius="8dp" android:bottomLeftRadius="28dp" />
        </shape>
    </item>
    <item>
        <selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="220">
            <item android:state_enabled="false">
                <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                    <solid android:color="@color/md_surface_highest" />
                    <corners android:topLeftRadius="28dp" android:topRightRadius="8dp" android:bottomRightRadius="8dp" android:bottomLeftRadius="28dp" />
                </shape>
            </item>
            <item android:state_pressed="true">
                <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                    <solid android:color="@color/md_secondary_container" />
                    <corners android:topLeftRadius="12dp" android:topRightRadius="8dp" android:bottomRightRadius="8dp" android:bottomLeftRadius="12dp" />
                </shape>
            </item>
            <item>
                <shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
                    <solid android:color="@color/md_secondary_container" />
                    <corners android:topLeftRadius="28dp" android:topRightRadius="8dp" android:bottomRightRadius="8dp" android:bottomLeftRadius="28dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
